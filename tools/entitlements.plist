<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The bundled Node (browser-runtime/node/bin/node) only: V8 compiles JavaScript to machine code
	     in MAP_JIT memory, which the hardened runtime refuses without this. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
